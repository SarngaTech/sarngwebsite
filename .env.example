# Public site URL (used for SEO, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://www.sarnginfotech.com

# Official WhatsApp Business number (digits only, with country code).
# Leave empty to hide WhatsApp CTAs until the number is confirmed.
NEXT_PUBLIC_WHATSAPP_NUMBER=918438653708

# --- Server-only integrations (never prefixed with NEXT_PUBLIC_) ---
# Optional webhook that receives every enquiry/application as JSON
# (e.g. Zapier, Make, n8n, CRM inbound webhook, custom API).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# --- Email: enquiries to the team + automatic reply to the person ---
# GoDaddy Professional Email (values from Sarng_Infotech_Email_Setup_Filled.xlsx)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=director@sarnginfotech.com
# Enter the mailbox password ONLY in your hosting provider's environment settings — never commit it.
SMTP_PASS=
# GoDaddy normally requires the sender to be the logged-in mailbox (or one of its aliases)
MAIL_FROM="Sarng Infotech <director@sarnginfotech.com>"
# Where enquiry/registration notifications are delivered (comma-separate for several)
LEAD_NOTIFY_TO=info@sarnginfotech.com

# --- Database: Neon PostgreSQL (the Neon <-> Vercel integration sets both automatically) ---
# Pooled connection string, used by the website at runtime
DATABASE_URL=# keep Neon credentials secure: do not expose them to client-side code

DATABASE_URL='postgresql://neondb_owner:npg_npPTYkzJ97Dc@ep-odd-river-b36blec6-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# Direct (unpooled) connection string, used by `prisma migrate deploy`
DATABASE_URL_UNPOOLED=

# --- Admin dashboard (/admin) ---
# Strong password for the team login
ADMIN_PASSWORD=
# Random string of at least 32 characters used to sign login sessions (e.g. `openssl rand -base64 48`)
ADMIN_SESSION_SECRET=
