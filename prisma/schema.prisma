// Sarng Infotech enquiry management — Neon PostgreSQL via Prisma.
// DATABASE_URL = Neon pooled connection (runtime), DATABASE_URL_UNPOOLED = direct connection (migrations).

generator client {
  provider = "prisma-client-js"
  // Engine-free client: uses Prisma's bundled WebAssembly query compiler with the `pg` driver adapter,
  // so no native query-engine binary is needed at runtime (smaller, faster serverless functions on Vercel).
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum EnquiryType {
  ENQUIRY
  CONTACT
  INTERNSHIP
  PROJECT
}

/// Workflow: NEW → CONTACTED → FOLLOW_UP → ENROLLED / CLOSED
enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  ENROLLED
  CLOSED
}

enum EmailKind {
  NOTIFICATION
  AUTO_REPLY
}

/// SKIPPED = email is not configured (SMTP settings missing)
enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Enquiry {
  id        String        @id @default(cuid())
  /// Human-friendly unique reference, e.g. SI-2026-01001 (generated by a database sequence)
  reference String        @unique @default(dbgenerated("('SI-'::text || to_char((now() AT TIME ZONE 'Asia/Kolkata'::text), 'YYYY'::text) || '-'::text || lpad((nextval('enquiry_reference_seq'::regclass))::text, 5, '0'::text))"))
  type      EnquiryType
  status    EnquiryStatus @default(NEW)

  name        String
  email       String
  phone       String
  persona     String?
  interest    String?
  batch       String?
  message     String?
  college     String?
  degree      String?
  year        String?
  technology  String?
  skillLevel  String?
  projectType String?
  /// Page the form was submitted from
  source      String?

  /// One-way hash of the visitor IP (used only for rate limiting)
  ipHash    String?
  userAgent String?

  notificationStatus EmailStatus @default(PENDING)
  autoReplyStatus    EmailStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resume EnquiryFile?
  notes  EnquiryNote[]
  emails EmailLog[]
  events EnquiryEvent[]

  @@index([createdAt])
  @@index([status])
  @@index([type])
  @@index([email])
  @@index([ipHash, createdAt])
}

/// Internship resume, stored in the database and served only to logged-in admins
model EnquiryFile {
  id        String   @id @default(cuid())
  enquiryId String   @unique
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model EnquiryNote {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  body      String
  author    String?
  createdAt DateTime @default(now())

  @@index([enquiryId, createdAt])
}

/// One row per email attempt (initial send and every resend)
model EmailLog {
  id        String      @id @default(cuid())
  enquiryId String
  enquiry   Enquiry     @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  kind      EmailKind
  status    EmailStatus
  recipient String
  subject   String
  messageId String?
  error     String?
  /// "submission" or "resend"
  trigger   String
  createdAt DateTime    @default(now())

  @@index([enquiryId, createdAt])
}

/// Audit trail: created, status_changed, email_resent, note_added
model EnquiryEvent {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([enquiryId, createdAt])
}

/// Used to slow down password guessing on /admin
model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}
